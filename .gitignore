.coverage
htmlcov/

# Локальные замеры: данные живут в отдельном приватном репозитории
*.jsonl
config.local.*

# Клон каталога правил, который делает .github/workflows/rules-inbox.yml.
# Он живёт в рабочем каталоге рядом со своим кодом, а гейты собирают входы
# через `git ls-files --others`: без этой строки чужие исходники попали бы
# под нашу же маску входа и покраснели бы на чужих правилах (правило 119).
.rules-catalogue/

# Значки живут на отдельной ветке `badges`, а не здесь. Собирает их
# .github/workflows/badges.yml, и в общей ветке их быть не должно: значок в
# `main` пересобирается от каждого изменения и даёт конфликт на каждом
# слиянии — красное не потому, что что-то сломалось (правило 051).
#
# Прогон добавляет их на своей ветке через `git add -f`: без этого игнор
# сработал бы и там, а сторож увидел бы «значки не изменились» и вышел бы
# зелёным, ничего не опубликовав (правило 075).
.github/badges/
